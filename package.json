{
  "name": "claudex-web",
  "version": "4.0.1",
  "type": "module",
  "description": "Codex 与 Claude Code 的浏览器工作台",
  "license": "GPL-3.0-only",
  "engines": {
    "node": ">=24.5"
  },
  "bin": {
    "claudex-web": "bin/claudex-web.mjs"
  },
  "files": [
    "build-info.json",
    "CHANGELOG.md",
    "LICENSE",
    "bin/",
    "client/dist/",
    "server/src/",
    "shared/",
    "scripts/install-services.mjs",
    "scripts/start-backend.mjs",
    "scripts/restart-when-idle.mjs",
    ".env.example",
    "docs/",
    "packages/translation-engine/src/",
    "packages/translation-engine/native/",
    "packages/translation-engine/bin/",
    "packages/translation-engine/package.json",
    "packages/translation-engine/LICENSE",
    "packages/translation-engine/README.md"
  ],
  "workspaces": [
    "client",
    "server",
    "packages/translation-engine"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @claudex-web/client",
    "build": "npm run build --workspace @claudex-web/translation-engine && npm run build --workspace @claudex-web/client",
    "icons:generate": "node scripts/generate-icons.mjs",
    "prepack": "npm run build",
    "start": "node --env-file-if-exists=.env server/src/server.mjs",
    "start:backend": "node --env-file-if-exists=.env scripts/start-backend.mjs",
    "test": "npm run test:unit && npm run test:components",
    "test:unit": "node --test client/tests/*.test.js server/tests/*.test.mjs tests/architecture.test.mjs tests/version.test.mjs tests/release.test.mjs tests/npm-release.test.mjs packages/translation-engine/tests/*.test.mjs",
    "test:components": "node scripts/test-components.mjs",
    "test:package": "npm run build && node --test tests/package.test.mjs",
    "version:check": "node scripts/version.mjs check",
    "version:prepare": "node scripts/version.mjs prepare",
    "release:check": "node scripts/version.mjs release",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "architecture:check": "node scripts/architecture.mjs",
    "check": "npm run version:check && npm run architecture:check && npm run format:check && npm test && npm run test:package",
    "service:install": "node --env-file-if-exists=.env scripts/install-services.mjs",
    "service:restart": "systemctl --user restart claudex-web.service",
    "service:status": "systemctl --user status claudex-web.service codex-app-server.service --no-pager",
    "service:restart-when-idle": "node --env-file-if-exists=.env scripts/restart-when-idle.mjs",
    "test:backends": "node scripts/test-backends.mjs",
    "test:backends:live": "node tests/integration/dual-backends-live.mjs",
    "test:codex:live": "node tests/integration/codex-native-lifecycle.mjs"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "prettier": "3.9.10",
    "react": "19.3.1",
    "react-test-renderer": "19.3.1"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.318",
    "node-pty": "1.1.0",
    "ws": "8.22.0",
    "@claudex-web/translation-engine": "file:packages/translation-engine",
    "fflate": "0.8.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hjd-hitsz/claudex-web.git"
  },
  "homepage": "https://github.com/hjd-hitsz/claudex-web#readme",
  "bugs": {
    "url": "https://github.com/hjd-hitsz/claudex-web/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
