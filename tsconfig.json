{
  "compilerOptions": {
    "target": "ES2024",
    "lib": ["ES2024", "DOM"],
    "module": "NodeNext",
    "types": ["node"],
    "allowJs": true,
    "strict": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "noEmit": true
  },
  "include": [
    "server/src",
    "shared",
    "packages/background-terminal",
    "packages/translation-engine/src"
  ]
}
